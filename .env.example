MINIO_ROOT_USER=bhrakshak
MINIO_ROOT_PASSWORD=bhrakshak-secret
MINIO_BUCKET=bhrakshak-media

JWT_SECRET=change-me-in-production-9f2c1a
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

MARTIN_PORT=3001
API_PORT=8000
DASHBOARD_PORT=3000
PWA_PORT=5173

# demo flags
DEMO_MODE=true
FIXTURE_MODE=false   # true = replay cached data, no external calls
OPEN_METEO_BASE=https://api.open-meteo.com/v1
