POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://bhrakshak:bhrakshak@postgres:5432/bhrakshak
DATABASE_URL_SYNC=postgresql+psycopg://bhrakshak:bhrakshak@postgres:5432/bhrakshak
