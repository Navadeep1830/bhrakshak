# ---- BhuRakshak environment (copy to .env) ----
POSTGRES_USER=bhrakshak
POSTGRES_PASSWORD=bhrakshak
POSTGRES_DB=bhrakshak
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://bhrakshak:bhrakshak@postgres:5432/bhrakshak
DATABASE_URL_SYNC=postgresql+psycopg://bhrakshak:bhrakshak@postgres:5432/bhrakshak
REDIS_URL=redis://redis:6379/0
MQTT_HOST=mosquitto
MQTT_PORT=1883

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=bhrakshak
MINIO_ROOT_PASSWORD=bhrakshak-secret
MINIO_BUCKET=bhrakshak-media

JWT_SECRET=change-me-in-production-9f2c1a
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

MARTIN_PORT=3001
API_PORT=8000
DASHBOARD_PORT=3000
PWA_PORT=5173

# demo flags
DEMO_MODE=true
FIXTURE_MODE=false   # true = replay cached data, no external calls
OPEN_METEO_BASE=https://api.open-meteo.com/v1

# CORS (comma-separated) — add preview URLs for judges
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# alert channels — all dryrun by default so `make up && make demo` works with no keys
# Fill to go live: MSG91_API_KEY, TWILIO_*, FCM_CREDENTIALS_JSON, EXOTEL_*, SIREN_WEBHOOK_URL
SMS_PROVIDER=dryrun
ALERT_SMS_DRYRUN=true
FCM_DRYRUN=true
IVR_PROVIDER=dryrun
SIREN_WEBHOOK_URL=

# weather provider: open_meteo (default) or imd (stub, needs IMD_API_KEY)
BHURAKSHAK_WEATHER_PROVIDER=open_meteo
IMD_API_KEY=
